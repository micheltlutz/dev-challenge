{
  "name": "dev-challenge lab",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",

  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "lts" },
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers/features/sqlite:1": {}
  },

  "postCreateCommand": "bash .devcontainer/setup.sh",

  "postAttachCommand": {
    "api": "uvicorn app.main:app --host 0.0.0.0 --port 8000 --reload"
  },

  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": { "label": "Reference API", "onAutoForward": "notify" }
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "charliermarsh.ruff",
        "ms-playwright.playwright",
        "redhat.vscode-yaml"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "editor.formatOnSave": true,
        "[python]": { "editor.defaultFormatter": "charliermarsh.ruff" }
      }
    }
  },

  "remoteEnv": {
    "SECRET": "devcontainer-local-key-not-for-production",
    "PYTHONUNBUFFERED": "1"
  }
}
