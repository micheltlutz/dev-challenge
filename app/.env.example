# Copy to app/.env and adjust. Every value here has a default in app/config.py,
# so this file is optional for local use.
#
# app/.env is git-ignored on purpose. Never commit a real SECRET.

APP_ENV=local
PROJECT_NAME="Development challenge"
LOG_LEVEL=INFO
VERSION=2.0.0

# JWT signing key. Generate your own with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# If unset, the app generates an ephemeral key at startup.
SECRET=
ALGORITHM=HS256
TOKEN_EXPIRES=30

DATABASE_URL=sqlite:///./dev-challenge.db

# Comma-separated origins, or * for any.
CORS_ALLOW_ORIGINS=*

# Set to true to log every SQL statement.
SQL_ECHO=false
