    "/balance/": {
      "get": {
        "description": "Returns the calculated balance over the authenticated user's own statements.\n\n- **Deposit**: the amount is added to the balance.\n- **Withdrawal**: the amount is subtracted from the balance.\n- **Transfer** to their own account (`to_user == from_user`): the amount is added.\n- **Transfer** to another account (`to_user != from_user`): the amount is subtracted.",
        "operationId": "get_calculated_balance_balance__get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Balance"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Get Calculated Balance",
        "tags": [
          "balance"
        ]
      }
    },
