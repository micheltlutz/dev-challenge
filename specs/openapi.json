    "/statements/": {
      "get": {
        "description": "Return the authenticated user's statements, newest first.",
        "operationId": "list_statements_statements__get",
        "parameters": [
          {
            "description": "Number of statements to skip.",
            "in": "query",
            "name": "skip",
            "required": false,
            "schema": {
              "default": 0,
              "description": "Number of statements to skip.",
              "minimum": 0,
              "title": "Skip",
              "type": "integer"
            }
          },
          {
            "description": "Number of statements to return.",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 10,
              "description": "Number of statements to return.",
              "maximum": 100,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
