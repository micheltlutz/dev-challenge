{
  "$description": "Design tokens for the dev-challenge lab, in W3C Design Tokens (DTCG) format. Colour values were sampled from the hi-fi mockups in readme_files/images/; spacing, radii and type scale were derived from the same 1440x1024 (web) and 375x812 (mobile) frames. Regenerate specs/design/tokens.css with: python scripts/build_tokens.py",
  "color": {
    "$type": "color",
    "brand": {
      "primary": {
        "$value": "#8E48EC",
        "$description": "Primary purple. Auth split-panel background, active nav, table headers."
      },
      "primary-deep": {
        "$value": "#4E01B4",
        "$description": "Deeper purple used for the active sidebar item and logo mark."
      },
      "primary-soft": {
        "$value": "#C79BEC",
        "$description": "Tint of the primary, for illustration fills and hover states."
      },
      "primary-wash": {
        "$value": "#F7F1FE",
        "$description": "Lightest purple wash, for selected rows and subtle highlights."
      }
    },
    "action": {
      "default": {
        "$value": "#19191C",
        "$description": "Near-black. Primary CTA buttons ('Log in', 'Create account', 'Save')."
      },
      "hover": { "$value": "#2A2A2D" },
      "disabled": { "$value": "#A0A0A6" },
      "on-action": { "$value": "#FFFFFF" }
    },
    "surface": {
      "canvas": {
        "$value": "#EFEFF0",
        "$description": "App background behind the dashboard shell."
      },
      "card": { "$value": "#FFFFFF" },
      "sunken": { "$value": "#F5F5F6" },
      "border": { "$value": "#EBEBEB" }
    },
    "text": {
      "primary": { "$value": "#19191C" },
      "secondary": { "$value": "#37474F" },
      "muted": { "$value": "#666668" },
      "inverse": { "$value": "#FFFFFF" }
    },
    "semantic": {
      "credit": {
        "$value": "#0CB97B",
        "$description": "Money in. Positive amounts, upward arrows, the Earnings KPI."
      },
      "credit-soft": { "$value": "#49CB9C" },
      "debit": {
        "$value": "#E02244",
        "$description": "Money out. Negative amounts and downward arrows."
      },
      "debit-soft": {
        "$value": "#E4482B",
        "$description": "Warmer red used on the Expenses KPI icon."
      },
      "warning": { "$value": "#E4A82B" },
      "info": { "$value": "#37474F" }
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": {
        "$value": ["Poppins", "Inter", "system-ui", "-apple-system", "Segoe UI", "sans-serif"],
        "$description": "Geometric sans. The mockups use Poppins; the fallbacks keep the feel without a webfont."
      }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "medium": { "$value": 500 },
      "semibold": { "$value": 600 },
      "bold": { "$value": 700 }
    },
    "size": {
      "$type": "dimension",
      "xs": { "$value": "12px" },
      "sm": { "$value": "14px" },
      "md": { "$value": "16px" },
      "lg": { "$value": "20px" },
      "xl": { "$value": "24px" },
      "2xl": { "$value": "32px" },
      "3xl": { "$value": "40px" }
    },
    "line-height": {
      "tight": { "$value": "1.2" },
      "normal": { "$value": "1.5" },
      "relaxed": { "$value": "1.7" }
    }
  },
  "space": {
    "$type": "dimension",
    "$description": "4px base scale.",
    "0": { "$value": "0px" },
    "1": { "$value": "4px" },
    "2": { "$value": "8px" },
    "3": { "$value": "12px" },
    "4": { "$value": "16px" },
    "5": { "$value": "24px" },
    "6": { "$value": "32px" },
    "7": { "$value": "48px" },
    "8": { "$value": "64px" }
  },
  "radius": {
    "$type": "dimension",
    "sm": { "$value": "4px" },
    "md": { "$value": "8px" },
    "lg": { "$value": "12px" },
    "xl": { "$value": "16px" },
    "pill": { "$value": "999px" },
    "circle": { "$value": "50%" }
  },
  "shadow": {
    "$type": "shadow",
    "card": {
      "$value": {
        "color": "rgba(25, 25, 28, 0.06)",
        "offsetX": "0px",
        "offsetY": "2px",
        "blur": "8px",
        "spread": "0px"
      }
    },
    "raised": {
      "$value": {
        "color": "rgba(25, 25, 28, 0.10)",
        "offsetX": "0px",
        "offsetY": "8px",
        "blur": "24px",
        "spread": "0px"
      }
    }
  },
  "layout": {
    "$type": "dimension",
    "breakpoint-mobile": { "$value": "375px" },
    "breakpoint-tablet": { "$value": "768px" },
    "breakpoint-desktop": { "$value": "1440px" },
    "sidebar-width": {
      "$value": "256px",
      "$description": "Web sidebar, and the mobile drawer width in menu-mobile.png."
    },
    "topbar-height": { "$value": "72px" },
    "content-max-width": { "$value": "1184px" },
    "field-height": { "$value": "48px" },
    "button-height": { "$value": "48px" }
  }
}
