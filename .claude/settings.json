{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(python scripts/validate_specs.py:*)",
      "Bash(python scripts/export_openapi.py:*)",
      "Bash(python scripts/build_tokens.py:*)",
      "Bash(python scripts/seed.py:*)",
      "Bash(python harness/cli.py:*)",
      "Bash(pytest:*)",
      "Bash(ruff check:*)",
      "Bash(curl -s http://localhost:*)",
      "Bash(curl -sf http://localhost:*)"
    ],
    "deny": [
      "Read(./app/.env)",
      "Read(./**/.env)"
    ]
  }
}
